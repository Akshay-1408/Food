# Strapi Server Configuration
HOST=0.0.0.0
PORT=1337

# Secrets (Generate using: openssl rand -base64 32 or similar)
APP_KEYS="toBeModifiedKey1,toBeModifiedKey2"
API_TOKEN_SALT=toBeModifiedSalt
ADMIN_JWT_SECRET=toBeModifiedAdminJwtSecret
TRANSFER_TOKEN_SALT=toBeModifiedTransferSalt
JWT_SECRET=toBeModifiedJwtSecret
ENCRYPTION_KEY=toBeModifiedEncryptionKey

# Database Configuration
# Default is sqlite for local development. For PostgreSQL (e.g. Neon, Supabase, Render):
DATABASE_CLIENT=sqlite
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Allowed Frontend URL for CORS
FRONTEND_URL=https://food-two-ruddy.vercel.app
